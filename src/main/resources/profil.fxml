<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllors.Profil"
            prefWidth="1000" prefHeight="550"
            style="-fx-background-color: #f8f4ea;"> <!-- Fond beige doux -->

    <HBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- 📋 Section Réservations -->
        <VBox spacing="15" prefWidth="430"
              style="-fx-background-color: white; -fx-background-radius: 15;
                     -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 2, 1);">

            <Label text="Your Reservations"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3e2723;" />
            <Label text="Reservations"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5d4037;" />

            <ScrollPane prefWidth="15" prefHeight="450"
                        style="-fx-background-color: #5d4037; -fx-border-color: #8d6e63;">
                <content>
                    <TilePane fx:id="cardsContainer"
                              hgap="15" vgap="15"
                              prefColumns="1" prefTileWidth="350"
                              style="-fx-padding: 10;" />
                </content>
            </ScrollPane>
        </VBox>

        <!-- 📅 Section Calendrier -->
        <VBox spacing="15" prefWidth="520"
              style="-fx-background-color: white; -fx-background-radius: 20;
                     -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.3, 0, 2);">
            <Label text="Calendar"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3e2723;" />
            <GridPane fx:id="calendarGrid"
                      hgap="10" vgap="10"
                      style="-fx-background-color: transparent;" />
        </VBox>
    </HBox>

    <!-- ✏️ Formulaire d'édition -->
    <AnchorPane fx:id="editPane" visible="false"
                layoutX="250.0" layoutY="140.0"
                prefHeight="280.0" prefWidth="500.0"
                style="-fx-background-color: white; -fx-border-radius: 15;
                       -fx-background-radius: 15; -fx-border-color: #d7ccc8;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.2, 0, 2);">
        <children>
            <Label text="✏️ Edit Reservation" layoutX="20.0" layoutY="20.0"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3e2723;" />

            <Label text="Seats :" layoutX="20.0" layoutY="70.0"
                   style="-fx-font-size: 14px; -fx-text-fill: #5d4037;" />
            <TextField fx:id="seatsField" layoutX="100.0" layoutY="65.0" prefWidth="300.0"
                       style="-fx-background-color: white; -fx-border-color: #d7ccc8;
                              -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 6;" />

            <Label text="Notes :" layoutX="20.0" layoutY="110.0"
                   style="-fx-font-size: 14px; -fx-text-fill: #5d4037;" />
            <TextArea fx:id="notesField" layoutX="100.0" layoutY="105.0" prefHeight="60.0" prefWidth="300.0"
                      style="-fx-background-color: white; -fx-border-color: #d7ccc8;
                             -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 6;" />

            <Button text="Cancel" layoutX="100.0" layoutY="185.0"
                    style="-fx-background-color: #d7ccc8; -fx-text-fill: #5d4037;
                           -fx-background-radius: 20; -fx-font-weight: bold;"
                    onAction="#closeEditPane" />

            <Button text="Submit" layoutX="250.0" layoutY="185.0"
                    style="-fx-background-color: #8d6e63; -fx-text-fill: white;
                           -fx-background-radius: 20; -fx-font-weight: bold;"
                    onAction="#saveEditedReservation" />
        </children>
    </AnchorPane>
</AnchorPane>
