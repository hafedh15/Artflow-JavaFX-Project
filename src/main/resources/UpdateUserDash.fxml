<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.UpdateUserControllerDash">
    <children>
        <Label text="Name" layoutX="20" layoutY="20"/>
        <TextField fx:id="nameField" layoutX="100" layoutY="20"/>

        <Label text="Lastname" layoutX="20" layoutY="60"/>
        <TextField fx:id="lastnameField" layoutX="100" layoutY="60"/>

        <Label text="Email" layoutX="20" layoutY="100"/>
        <TextField fx:id="emailField" layoutX="100" layoutY="100"/>

        <Label text="Roles" layoutX="20" layoutY="140"/>
        <ComboBox fx:id="rolesComboBox" layoutX="100" layoutY="140"/>

        <Label text="Banned" layoutX="20" layoutY="180"/>
        <ComboBox fx:id="bannedComboBox" layoutX="100" layoutY="180"/>

        <Label text="Photo" layoutX="20" layoutY="220"/>
        <Button text="Choose Photo" layoutX="100" layoutY="220" onAction="#handleChoosePhoto"/>

        <Button text="Update" layoutX="100" layoutY="270" onAction="#handleUpdateDash"/>
    </children>
</AnchorPane>
