<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.FrontWorkshop"
            style="-fx-background-color: #F9F5F1;">


    <!-- 🔹 Contenu principal -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Titre page -->
            <Label text="🌿 Our Workshops"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />

            <!-- Liste ateliers -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: transparent;">
                <content>
                    <TilePane fx:id="cardsContainer"
                              hgap="20.0" vgap="20.0"
                              prefColumns="3"
                              prefTileWidth="240.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 10;
                                     -fx-padding: 20;
                                     -fx-border-color: #E8DECD;
                                     -fx-border-radius: 10;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    </TilePane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>