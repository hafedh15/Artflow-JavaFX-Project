<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllors.FrontWorkshop"
            style="-fx-background-color: #F9F5F1;">

    <!-- 🔹 Top Menu Bar -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #E5DDD1; -fx-padding: 15;">
            <!-- Logo + Navigation -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <ImageView fitHeight="50" fitWidth="120" preserveRatio="true">
                    <Image url="@/images/logo.jpg" />
                </ImageView>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Accueil" style="-fx-background-color: transparent; -fx-text-fill: #8D7B6A; -fx-font-size: 14px;"/>
                <Button text="Produits" style="-fx-background-color: transparent; -fx-text-fill: #8D7B6A; -fx-font-size: 14px;"/>
                <Button text="Ateliers" style="-fx-background-color: #C8B6A6; -fx-text-fill: #5C4F3D; -fx-font-size: 14px; -fx-background-radius: 5;"/>
                <Button text="Réclamations" style="-fx-background-color: transparent; -fx-text-fill: #8D7B6A; -fx-font-size: 14px;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Espace User -->
                <ImageView fitHeight="30" fitWidth="30">
                    <Image url="@/images/user.jpg" />
                </ImageView>
            </HBox>

            <!-- Barre de recherche -->
            <HBox spacing="10" alignment="CENTER">
                <TextField prefWidth="400" promptText="Rechercher un atelier..."
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 15;
                                  -fx-background-color: #FFFFFF; -fx-border-color: #E8DECD;"/>
                <Button text="🔎" style="-fx-background-color: #A18E78; -fx-background-radius: 20; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <!-- 🔹 Contenu principal -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Titre page -->
            <Label text="🌿 Our Workshops"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />

            <!-- Liste ateliers -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: transparent;">
                <content>
                    <TilePane fx:id="cardsContainer"
                              hgap="20.0" vgap="20.0"
                              prefColumns="3"
                              prefTileWidth="240.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 10;
                                     -fx-padding: 20;
                                     -fx-border-color: #E8DECD;
                                     -fx-border-radius: 10;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    </TilePane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>