<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.ResetPasswordController"
            prefWidth="400" prefHeight="300"
            style="-fx-background-color: linear-gradient(to bottom right, #e0eafc, #cfdef3);">

    <VBox spacing="15" alignment="CENTER"
          layoutX="50" layoutY="30"
          prefWidth="300"
          AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50"
          AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="30"
          style="-fx-background-color: white;
                 -fx-background-radius: 10;
                 -fx-padding: 30;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);">

        <Label text="Reset Password"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #333;
                      -fx-font-family: 'Segoe UI';" />

        <PasswordField fx:id="newPasswordField"
                       promptText="New Password"
                       style="-fx-background-radius: 5;
                              -fx-border-color: #ccc;
                              -fx-border-radius: 5;
                              -fx-padding: 10;
                              -fx-font-size: 14px;" />

        <PasswordField fx:id="confirmPasswordField"
                       promptText="Confirm Password"
                       style="-fx-background-radius: 5;
                              -fx-border-color: #ccc;
                              -fx-border-radius: 5;
                              -fx-padding: 10;
                              -fx-font-size: 14px;" />

        <Label fx:id="errorLabel"
               textFill="red"
               style="-fx-font-size: 12px; -fx-text-fill: #f44336;" />

        <Label fx:id="successLabel"
               textFill="green"
               style="-fx-font-size: 13px; -fx-text-fill: #4CAF50;" />

        <Button text="Reset Password"
                onAction="#handleResetPassword" maxWidth="Infinity"
                style="-fx-background-color: #4CAF50;
                       -fx-text-fill: white;
                       -fx-background-radius: 8;
                       -fx-font-size: 14px;
                       -fx-padding: 10;
                       -fx-pref-width: 100%;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"



                onMouseEntered="#hoverResetButton"
                onMouseExited="#unhoverResetButton" />
    </VBox>
</AnchorPane>
