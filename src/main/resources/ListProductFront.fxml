<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.Contollers.ListProductFront"
            prefHeight="700.0" prefWidth="1000.0"
            stylesheets="@/styles.css">

   <!-- Barre de navigation supérieure -->
   <top>
      <VBox>
         <!-- Logo et barre de menu principale -->
         <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

            <!-- Logo -->
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
               <Image url="@/images/logo.jpg"/>
            </ImageView>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Menu principal -->
            <Button text="Accueil" styleClass="nav-button" />
            <Button text="Produits" styleClass="nav-button-active" />
            <Button text="Ateliers" styleClass="nav-button" />
            <Button text="Reclamations" styleClass="nav-button" />
            <Button text="À propos" styleClass="nav-button" />

            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="cartButton" styleClass="cart-button" onAction="#openCart">
               <graphic>
                  <ImageView fitHeight="25" fitWidth="25">
                     <Image url="@/images/panier.jpg"/>
                  </ImageView>
               </graphic>
            </Button>
            <!-- Icône utilisateur -->
            <Button styleClass="user-icon" onAction="#profil">
               <graphic>
                  <ImageView fitHeight="25" fitWidth="25">
                     <Image url="@/images/user.jpg"/>
                  </ImageView>
               </graphic>
            </Button>
         </HBox>

         <!-- Sous-menu de catégories -->
         <HBox fx:id="categoryBoxx" alignment="CENTER" spacing="10" styleClass="category-bar">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
         </HBox>
      </VBox>
   </top>

   <!-- Contenu principal - panneau de recherche à gauche et produits à droite -->
   <center>
      <HBox spacing="0">
         <!-- Filtres sur la gauche -->
         <VBox spacing="15" styleClass="filter-panel" minWidth="200" maxWidth="250" style="-fx-background-color: #f9f7f2;">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
               <TextField fx:id="searchField"
                          promptText="Rechercher un produit..."
                          prefWidth="200"
                          styleClass="search-text-field"/>
            </HBox>

            <Label text="Catégories" styleClass="filter-title"/>
            <VBox fx:id="categoryBox" spacing="8" styleClass="categories-list"/>

            <!-- Filtre par prix - Avec deux curseurs -->
            <Label text="Filter by Price" styleClass="filter-title"/>

            <!-- Affichage des valeurs min et max actuelles -->
            <HBox spacing="10" alignment="CENTER_LEFT">
               <Label text="Min:" styleClass="price-label"/>
               <TextField fx:id="minPriceField" prefWidth="60" promptText="41" text="41" styleClass="price-input-field"/>
               <Label text="TND" styleClass="price-label"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
               <Label text="Max:" styleClass="price-label"/>
               <TextField fx:id="maxPriceField" prefWidth="60" promptText="412" text="412" styleClass="price-input-field"/>
               <Label text="TND" styleClass="price-label"/>
            </HBox>

            <Button text="Appliquer le filtre" styleClass="apply-filter-button" onAction="#applyPriceFilter" />
         </VBox>

         <!-- Zone d'affichage des produits en grille -->
         <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS">
            <content>
               <TilePane fx:id="productContainer"
                         hgap="20.0" vgap="20.0"
                         prefColumns="3"
                         prefTileWidth="320.0"
                         prefTileHeight="430.0"
                         style="-fx-background-color: white; -fx-padding: 20px;"
                         alignment="TOP_LEFT">
                  <padding>
                     <Insets top="20" right="20" bottom="20" left="20"/>
                  </padding>

                  <!-- Les produits seront générés dynamiquement ici par le contrôleur -->
               </TilePane>
            </content>
         </ScrollPane>
      </HBox>
   </center>

   <!-- Pied de page -->
   <bottom>
      <HBox alignment="CENTER" spacing="10" styleClass="footer">
         <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
         <Label text="© 2025 - Artisanat fait main avec passion" />
      </HBox>
   </bottom>

</BorderPane>