<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.EditOrderController"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@/styles.css">

    <!-- Barre de navigation supérieure -->
    <top>
        <VBox>
            <!-- Logo et barre de menu principale -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

                <!-- Logo -->
                <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
                    <Image url="@/images/logo.jpg"/>
                </ImageView>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Menu principal avec emojis -->
                <Button text=" Accueil" styleClass="nav-button" onAction="#goToHome" />
                <Button text="Produits" styleClass="nav-button" onAction="#goToProductList" />
                <Button text=" Ateliers" styleClass="nav-button" onAction="#goToAteliers" />
                <Button text="Reclamations" styleClass="nav-button" onAction="#goToReclamations" />
                <Button text=" À propos" styleClass="nav-button" onAction="#goToAbout" />

                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="cartButton" styleClass="cart-button" onAction="#openCart">
                    <graphic>
                        <ImageView fitHeight="25" fitWidth="25">
                            <Image url="@/images/panier.jpg"/>
                        </ImageView>
                    </graphic>
                </Button>
                <!-- Icône utilisateur -->
                <Button styleClass="user-icon" onAction="#profil">
                    <graphic>
                        <ImageView fitHeight="30" fitWidth="30">
                            <Image url="@/images/user.jpg"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- Contenu principal - formulaire de modification -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="30.0" styleClass="content-container">
            <padding>
                <Insets top="40.0" right="20.0" bottom="40.0" left="20.0" />
            </padding>

            <Label styleClass="page-title" text="📦 Modifier les données de livraison">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <!-- Citation inspirante -->
            <Label styleClass="quote-text" text="« La qualité d'un service se mesure à l'attention portée aux détails. »" wrapText="true" alignment="CENTER">
                <font>
                    <Font name="System Italic" size="14.0" />
                </font>
            </Label>

            <VBox spacing="20.0" styleClass="form-container" maxWidth="700.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                </padding>

                <!-- Adresse -->
                <Label styleClass="form-label" text="📍 Adresse de livraison" />
                <TextField fx:id="addressField" styleClass="form-field" promptText="Entrez la nouvelle adresse de livraison" />
                <Label fx:id="addressErrorLabel" textFill="red" visible="false" />

                <!-- Téléphone -->
                <Label styleClass="form-label" text="📱 Numéro de téléphone" />
                <TextField fx:id="phoneField" styleClass="form-field" promptText="Entrez le nouveau numéro de téléphone" />
                <Label fx:id="phoneErrorLabel" textFill="red" visible="false" />

                <HBox alignment="CENTER" spacing="15.0">
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                    <Button fx:id="saveButton" mnemonicParsing="false" onAction="#saveChanges" styleClass="primary-button" text="💾 Enregistrer les modifications" />
                    <Button mnemonicParsing="false" onAction="#cancelEdit" styleClass="cancel-button" text="❌ Annuler" />
                    <ImageView fx:id="successGif"
                               fitHeight="150" fitWidth="150"
                               visible="false"
                               preserveRatio="true"
                               style="-fx-margin-top: 20;">
                        <Image url="@/images/success.gif"/>
                    </ImageView>
                </HBox>

                <!-- Citation sur l'importance de l'exactitude des données -->
                <Label styleClass="info-text" text="« Des informations précises garantissent une livraison réussie. »" wrapText="true" alignment="CENTER">
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Label>
            </VBox>
        </VBox>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="footer">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label text="© 2025 - 🎨 Artisanat fait main avec passion 💖" />
        </HBox>
    </bottom>
</BorderPane>