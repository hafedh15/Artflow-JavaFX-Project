<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.DeleteArticle"
            prefHeight="400.0" prefWidth="600.0">
    <VBox alignment="CENTER" spacing="20.0" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">
        <Label fx:id="messageLabel" text="Êtes-vous sûr de vouloir supprimer cet article ?" wrapText="true" />

        <HBox alignment="CENTER" spacing="30">
            <Button text="Annuler" onAction="#annulerSuppression" />
            <Button text="OK" onAction="#confirmerSuppression" />
        </HBox>
    </VBox>
</AnchorPane>
