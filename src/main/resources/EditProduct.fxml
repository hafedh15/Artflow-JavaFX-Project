<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.EditProduct"
            prefHeight="700.0" prefWidth="800.0"
            stylesheets="@/styles.css">

   <!-- Barre de navigation supérieure -->
   <top>
      <VBox>
         <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

            <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
               <Image url="@/images/logo.jpg"/>
            </ImageView>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Accueil" styleClass="nav-button" onAction="#goToHome" />
            <Button text="Produits" styleClass="nav-button-active" onAction="#goToProductList" />
            <Button text="Ateliers" styleClass="nav-button" />
            <Button text="Reclamations" styleClass="nav-button" />
            <Button text="À propos" styleClass="nav-button" />

            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="cart-button">
               <graphic>
                  <ImageView fitHeight="25" fitWidth="25">
                     <Image url="@/images/panier.jpg"/>
                  </ImageView>
               </graphic>
            </Button>
            <Button styleClass="user-icon" onAction="#goToProfil">
               <graphic>
                  <ImageView fitHeight="30" fitWidth="30">
                     <Image url="@/images/user.jpg"/>
                  </ImageView>
               </graphic>
            </Button>
         </HBox>
      </VBox>
   </top>

   <!-- Contenu principal - formulaire de modification -->
   <center>
      <VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f8f4ea;">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="page-title" text="Modifier un produit">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>

            <!-- Nom -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Nom du produit" />
                  <TextField fx:id="nameE" promptText="Entrez le nom du produit" styleClass="input-field" />
                  <Label fx:id="errorNameE" text="Le nom est obligatoire" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Description -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Description" />
                  <TextField fx:id="descriptionE" promptText="Entrez la description" styleClass="input-field" />
                  <Label fx:id="errorDescriptionE" text="La description est obligatoire" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Prix -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Prix" />
                  <TextField fx:id="priceE" promptText="Entrez le prix" styleClass="input-field" />
                  <Label fx:id="errorPriceE" text="Prix invalide" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Catégorie -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Catégorie" />
                  <TextField fx:id="categoryE" promptText="Entrez la catégorie" styleClass="input-field" />
                  <Label fx:id="errorCategoryE" text="La catégorie est obligatoire" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Image -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Image" />
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="imageE" editable="false" promptText="Chemin de l'image" HBox.hgrow="ALWAYS" styleClass="input-field" />
                        <Button mnemonicParsing="false" onAction="#choosefile" styleClass="browse-button" text="Parcourir" />
                     </children>
                  </HBox>
                  <Label fx:id="errorImageE" text="Veuillez sélectionner une image" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Boutons d'action -->
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#Edit" styleClass="action-button" text="Enregistrer les modifications" />
                  <Button mnemonicParsing="false" onAction="#goToProductList" styleClass="cancel-button" text="Annuler" />
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </center>

   <!-- Pied de page -->
   <bottom>
      <HBox alignment="CENTER" spacing="10" styleClass="footer">
         <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
         <Label text="© 2025 - Artisanat fait main avec passion" />
      </HBox>
   </bottom>
</BorderPane>
