<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="mainContainer" prefHeight="700.0" prefWidth="1000.0" spacing="10.0" styleClass="main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Contollers.EditProduct">
   <children>
      <!-- Navbar -->
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="navbar">
         <children>
            <Label styleClass="logo-text" text="NomDuSite">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" styleClass="nav-button" text="Accueil" />
                  <Button mnemonicParsing="false" styleClass="nav-button" text="Produits" />
                  <Button mnemonicParsing="false" styleClass="nav-button" text="Profil" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>

      <!-- Contenu principal -->
      <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="content-container">
         <children>
            <Label styleClass="page-title" text="Modifier un produit">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <VBox spacing="10.0" styleClass="form-container" maxWidth="600.0">
               <children>
                  <Label styleClass="form-label" text="Nom du produit" />
                  <TextField fx:id="nameE" styleClass="form-field" promptText="Entrez le nom du produit" />

                  <Label styleClass="form-label" text="Description" />
                  <TextField fx:id="descriptionE" styleClass="form-field" promptText="Entrez la description" />

                  <Label styleClass="form-label" text="Prix" />
                  <TextField fx:id="priceE" styleClass="form-field" promptText="Entrez le prix" />

                  <Label styleClass="form-label" text="Catégorie" />
                  <TextField fx:id="categoryE" styleClass="form-field" promptText="Entrez la catégorie" />

                  <Label styleClass="form-label" text="Image" />
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="imageE" styleClass="form-field" promptText="Chemin de l'image" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#choosefile" styleClass="secondary-button" text="Parcourir" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#Edit" styleClass="primary-button" text="Enregistrer les modifications" />
                        <Button mnemonicParsing="false" styleClass="cancel-button" text="Annuler" />
                     </children>
                     <padding>
                        <Insets top="20.0" />
                     </padding>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</VBox>