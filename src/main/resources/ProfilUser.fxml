<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.artflow.controllers.ProfilUserController"
           prefHeight="700.0" prefWidth="1000.0"
           style="-fx-background-color: #f8f9fa;">

    <!-- Main Content Container -->
    <VBox spacing="20" style="-fx-padding: 30;">
        <!-- Header with Profile Image and Name -->
        <HBox alignment="CENTER_LEFT" spacing="30">
            <!-- Profile Picture Container (Makes it circular) -->
            <StackPane fx:id="profileImageContainer">
                <Circle fx:id="profileCircle" radius="60" fill="white">
                    <effect>
                        <DropShadow>
                            <color>
                                <Color opacity="0.2" />
                            </color>
                        </DropShadow>
                    </effect>
                </Circle>
                <ImageView fx:id="imgPhoto" fitWidth="120" fitHeight="120" preserveRatio="true">
                    <clip>
                        <Circle radius="60" centerX="60" centerY="60" />
                    </clip>
                </ImageView>

                <!-- Hover overlay that indicates the image is clickable -->
                <StackPane opacity="0.0" style="-fx-background-color: rgba(0,0,0,0.5);" mouseTransparent="true" fx:id="imageOverlay">
                    <Circle radius="60" fill="transparent" stroke="white" strokeWidth="2" />
                    <Label text="📷" style="-fx-font-size: 24px; -fx-text-fill: white;" />
                </StackPane>
            </StackPane>

            <!-- User Name and Quick Actions -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblFullName" text="User Name" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                    <Label fx:id="verifiedBadge" text="✓" style="-fx-font-size: 18px; -fx-text-fill: #0984e3;" />
                </HBox>
                <Label fx:id="lblEmail" text="user@example.com" style="-fx-font-size: 14px; -fx-text-fill: #636e72;" />
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Edit Profile" onAction="#goToUpdatePage"
                            style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 7 20;">
                        <graphic>
                            <Label text="✏️" style="-fx-text-fill: white;" />
                        </graphic>
                    </Button>
                    <Button text="Settings"
                            style="-fx-background-color: #f5f6fa; -fx-text-fill: #2d3436; -fx-background-radius: 20; -fx-padding: 7 20; -fx-border-color: #dfe6e9; -fx-border-radius: 20;">
                        <graphic>
                            <Label text="⚙️" />
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </HBox>

        <!-- Stats Bar -->
        <HBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="10">
                <VBox alignment="CENTER">
                    <Label text="Posts" style="-fx-font-size: 14px; -fx-text-fill: #636e72;" />
                    <Label fx:id="lblPostCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                </VBox>
            </HBox>
            <Separator orientation="VERTICAL" />
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="10">
                <VBox alignment="CENTER">
                    <Label text="Followers" style="-fx-font-size: 14px; -fx-text-fill: #636e72;" />
                    <Label fx:id="lblFollowerCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                </VBox>
            </HBox>
            <Separator orientation="VERTICAL" />
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="10">
                <VBox alignment="CENTER">
                    <Label text="Following" style="-fx-font-size: 14px; -fx-text-fill: #636e72;" />
                    <Label fx:id="lblFollowingCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                </VBox>
            </HBox>
        </HBox>

        <!-- Main Content with Tabs -->
        <TabPane style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="About">
                    <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                        <!-- User Information Section -->
                        <Label text="Personal Information" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />

                        <GridPane hgap="30" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label text="First Name:" style="-fx-font-weight: bold; -fx-text-fill: #636e72;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="lblName" text="John" style="-fx-text-fill: #2d3436;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Last Name:" style="-fx-font-weight: bold; -fx-text-fill: #636e72;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="lblLastname" text="Doe" style="-fx-text-fill: #2d3436;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #636e72;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="lblEmailDetail" text="john.doe@example.com" style="-fx-text-fill: #2d3436;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Account Status:" style="-fx-font-weight: bold; -fx-text-fill: #636e72;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                            <HBox alignment="CENTER_LEFT" spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <Label fx:id="lblVerified" text="Verified" style="-fx-text-fill: #2d3436;" />
                                <Label fx:id="verifiedIcon" text="✓" style="-fx-text-fill: #00b894;" />
                            </HBox>

                            <Label text="Member Since:" style="-fx-font-weight: bold; -fx-text-fill: #636e72;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                            <Label fx:id="lblDateCreation" text="January 1, 2023" style="-fx-text-fill: #2d3436;" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                            <Label text="Role:" style="-fx-font-weight: bold; -fx-text-fill: #636e72;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                            <Label fx:id="lblRole" text="Client" style="-fx-text-fill: #2d3436;" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                        </GridPane>

                        <Separator />

                        <!-- Bio Section -->
                        <Label text="Bio" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                        <TextFlow fx:id="bioTextFlow" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 5;">
                            <Label fx:id="lblBio" text="No bio information provided yet." style="-fx-text-fill: #636e72; -fx-font-style: italic;" />
                        </TextFlow>

                        <Button text="Edit Bio"
                                style="-fx-background-color: transparent; -fx-text-fill: #0984e3; -fx-padding: 5 0; -fx-border-color: transparent;">
                            <graphic>
                                <Label text="✏️" style="-fx-text-fill: #0984e3;" />
                            </graphic>
                        </Button>
                    </VBox>
                </Tab>

                <Tab text="Posts">
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                            <Label text="My Posts" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />

                            <!-- Placeholder for no posts -->
                            <VBox fx:id="noPostsPlaceholder" alignment="CENTER" spacing="10" style="-fx-padding: 50 0;">
                                <Label text="📝" style="-fx-font-size: 40px;" />
                                <Label text="No posts yet" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #636e72;" />
                                <Label text="Your posts will appear here" style="-fx-text-fill: #b2bec3;" />
                                <Button text="Create New Post"
                                        style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 7 20; -fx-font-weight: bold; -
                                                fx-cursor: hand;">
                                    <graphic>
                                        <Label text="+" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                    </graphic>
                                </Button>
                            </VBox>

                            <!-- Posts container (will be populated programmatically) -->
                            <VBox fx:id="postsContainer" spacing="15" />
                        </VBox>
                    </ScrollPane>
                </Tab>

                <Tab text="Gallery">
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                            <Label text="My Artwork" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />

                            <!-- Placeholder for empty gallery -->
                            <VBox fx:id="emptyGalleryPlaceholder" alignment="CENTER" spacing="10" style="-fx-padding: 50 0;">
                                <Label text="🖼️" style="-fx-font-size: 40px;" />
                                <Label text="No artwork yet" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #636e72;" />
                                <Label text="Your artwork gallery will appear here" style="-fx-text-fill: #b2bec3;" />
                                <Button text="Upload Artwork"
                                        style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 7 20; -fx-font-weight: bold; -fx-cursor: hand;">
                                    <graphic>
                                        <Label text="+" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                    </graphic>
                                </Button>
                            </VBox>

                            <!-- Gallery grid (will be populated programmatically) -->
                            <FlowPane fx:id="galleryContainer" hgap="10" vgap="10" />
                        </VBox>
                    </ScrollPane>
                </Tab>

                <Tab text="Activity">
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                            <Label text="Recent Activity" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />

                            <!-- Activity timeline container (will be populated programmatically) -->
                            <VBox fx:id="activityContainer" spacing="15">
                                <!-- Placeholder for no activity -->
                                <VBox fx:id="noActivityPlaceholder" alignment="CENTER" spacing="10" style="-fx-padding: 50 0;">
                                    <Label text="📊" style="-fx-font-size: 40px;" />
                                    <Label text="No recent activity" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #636e72;" />
                                    <Label text="Your activity timeline will appear here" style="-fx-text-fill: #b2bec3;" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>
</StackPane>