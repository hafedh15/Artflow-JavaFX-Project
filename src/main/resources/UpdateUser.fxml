<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="800.0" prefHeight="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.artflow.controllers.UpdateUserController"
            style="-fx-background-color: #f9f5f1;">

    <VBox alignment="TOP_CENTER" spacing="20"
          style="-fx-padding: 30;">

        <!-- Titre -->
        <Label text="Modifier les informations utilisateur"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />

        <!-- Zone de formulaire -->
        <VBox spacing="15" maxWidth="500">

            <!-- Champ Nom -->
            <VBox spacing="5">
                <Label text="Nom" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <TextField fx:id="txtName" promptText="Entrez votre nom"
                           style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                  -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                <Label fx:id="nameError" textFill="red" style="-fx-font-size: 11px;" />
            </VBox>

            <!-- Champ Prénom -->
            <VBox spacing="5">
                <Label text="Prénom" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <TextField fx:id="txtLastname" promptText="Entrez votre prénom"
                           style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                  -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                <Label fx:id="lastnameError" textFill="red" style="-fx-font-size: 11px;" />
            </VBox>

            <!-- Champ Email -->
            <VBox spacing="5">
                <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <TextField fx:id="txtEmail" promptText="Entrez votre email"
                           style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                  -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                <Label fx:id="emailError" textFill="red" style="-fx-font-size: 11px;" />
            </VBox>

            <!-- Champ Photo -->
            <VBox spacing="5">
                <Label text="Photo" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <HBox spacing="10">
                    <TextField fx:id="txtPhoto" promptText="Chemin de la photo" prefWidth="350"
                               editable="false"
                               style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                      -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                    <Button text="Parcourir" onAction="#browsePhoto"
                            style="-fx-background-color: #A18E78; -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-font-weight: bold;" />
                </HBox>
                <Label fx:id="photoError" textFill="red" style="-fx-font-size: 11px;" />
            </VBox>

        </VBox>

        <!-- Bouton Update -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="Modifier"
                    onAction="#updateUserInfo"
                    style="-fx-background-color: #5C4F3D; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;" />
        </HBox>

    </VBox>
</AnchorPane>