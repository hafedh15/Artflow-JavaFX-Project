<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.shape.Circle?>
<BorderPane prefWidth="1100.0" prefHeight="700.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.artflow.controllers.ConversationController"
            style="-fx-background-color: #F9F5F1;">

    <!-- Sidebar (Menu gauche) -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #8D7D6D;
                               -fx-padding: 20;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0.5, 4, 0);">


            <!-- Original profile image container -->
            <StackPane fx:id="profileImageContainer" alignment="CENTER" style="-fx-padding: 20 0 5 0; -fx-cursor: hand;">
                <VBox alignment="CENTER" spacing="10">
                    <StackPane>
                        <Circle radius="40" fill="white" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 0);"/>
                        <ImageView fx:id="userProfileImage" fitWidth="80" fitHeight="80" preserveRatio="false">
                            <Image url="@/images/user.jpg" />
                            <clip>
                                <Circle radius="40" centerX="40" centerY="40" />
                            </clip>
                        </ImageView>

                        <!-- Camera overlay (appears on hover) -->
                        <StackPane fx:id="imageOverlay" opacity="0.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 40;">
                            <Circle radius="40" fill="transparent" />
                            <Label text="📷" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                        </StackPane>
                    </StackPane>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #E8DECD; -fx-font-weight: bold;" text="Artisan Admin" />
                </VBox>
            </StackPane>

            <!-- Add the Generate Avatar button below the profile image -->
            <Button fx:id="generateAvatarButton" text="Generate Avatar"
                    style="-fx-background-color: #7D6E58; -fx-text-fill: #E8DECD; -fx-font-size: 12px; -fx-padding: 5 10; -fx-background-radius: 20; -fx-cursor: hand;">
                <graphic>
                    <Label text="✨" style="-fx-font-size: 12px; -fx-text-fill: #E8DECD;" />
                </graphic>
                <VBox.margin>
                    <Insets bottom="15" />
                </VBox.margin>
            </Button>
            <Separator style="-fx-background-color: #6B5D4A; -fx-padding: 0 15 0 15;" />

            <!-- Navigation Menu -->
            <VBox spacing="5" style="-fx-padding: 10 5;">
                <Button fx:id="GoToUser" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #E8DECD; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Utilisateurs" onAction="#goToUser">
                    <graphic>
                        <Label text="👥" style="-fx-font-size: 16px; -fx-text-fill: #E8DECD;" />
                    </graphic>
                </Button>

                <Button fx:id="orderButton" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Commandes" onAction="#handleOrderButtonAction">
                    <graphic>
                        <Label text="🛒" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToProduit" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Produits" onAction="#goToProduit">
                    <graphic>
                        <Label text="📦" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToAtelier" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Ateliers" onAction="#goToAtelier">
                    <graphic>
                        <Label text="🔨" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReservation" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réservations" onAction="#goToReservation">
                    <graphic>
                        <Label text="📅" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToArticle" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Articles" onAction="#goToArticle">
                    <graphic>
                        <Label text="📝" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToComment" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Commentaires" onAction="#goToComment">
                    <graphic>
                        <Label text="💬" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReclamation" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réclamations" onAction="#goToReclamation">
                    <graphic>
                        <Label text="⚠️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReponse" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réponses" onAction="#goToReponse">
                    <graphic>
                        <Label text="↩️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom Menu -->
            <VBox spacing="5" style="-fx-padding: 10 5 20 5;">
                <Button maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Rapports">
                    <graphic>
                        <Label text="📊" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Déconnexion">
                    <graphic>
                        <Label text="🚪" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <AnchorPane style="-fx-padding: 30;">
            <children>

                <!-- LEFT PANEL -->
                <VBox fx:id="leftPane"
                      spacing="20"
                      layoutX="20" layoutY="20"
                      prefWidth="260.0" prefHeight="560.0"
                      style="-fx-background-color: white;
                             -fx-border-color: #E8DECD;
                             -fx-border-width: 1.5;
                             -fx-border-radius: 12;
                             -fx-background-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);
                             -fx-padding: 20;">

                    <children>
                        <Label text="📋 Réclamations"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />

                        <ComboBox fx:id="filterComboBox"
                                  prefWidth="220.0"
                                  promptText="Filtrer par statut"
                                  style="-fx-background-color: #F7F7F7;
                                         -fx-border-color: #E8DECD;
                                         -fx-border-radius: 8;
                                         -fx-background-radius: 8;
                                         -fx-padding: 6;"/>

                        <ListView fx:id="reclamationListView"
                                  prefHeight="480.0"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #E8DECD;
                                         -fx-border-radius: 8;
                                         -fx-background-radius: 8;
                                         -fx-padding: 4;"/>
                    </children>
                </VBox>

                <!-- RIGHT PANEL -->
                <VBox fx:id="rightPane"
                      layoutX="320.0" layoutY="20.0"
                      spacing="20"
                      prefWidth="720.0" prefHeight="560.0"
                      style="-fx-background-color: white;
                             -fx-border-color: #E8DECD;
                             -fx-border-width: 1.5;
                             -fx-border-radius: 12;
                             -fx-background-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);
                             -fx-padding: 20;">

                    <children>

                        <!-- Details -->
                        <VBox spacing="10">
                            <children>
                                <Label fx:id="reclamationSubjectLabel"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                                <Label fx:id="reclamationStatusLabel"
                                       style="-fx-font-size: 13px; -fx-text-fill: #8D7B6A;" />
                                <Label fx:id="reclamationMessageLabel"
                                       wrapText="true"
                                       style="-fx-font-size: 14px; -fx-text-fill: #5C4F3D;" />
                            </children>
                        </VBox>

                        <!-- Chat Area -->
                        <ListView fx:id="chatListView"
                                  VBox.vgrow="ALWAYS"
                                  prefHeight="300.0"
                                  style="-fx-background-color: #F9F5F1;
                                         -fx-border-color: #E8DECD;
                                         -fx-border-radius: 10;
                                         -fx-background-radius: 10;
                                         -fx-padding: 8;"/>

                        <!-- Input Area -->
                        <VBox spacing="10">
                            <children>
                                <HBox spacing="10">
                                    <children>
                                        <TextField fx:id="responseField"
                                                   HBox.hgrow="ALWAYS"
                                                   promptText="Votre message..."
                                                   style="-fx-background-color: #F7F7F7;
                                                          -fx-border-color: #E8DECD;
                                                          -fx-border-radius: 8;
                                                          -fx-background-radius: 8;
                                                          -fx-padding: 8;"/>

                                        <Button fx:id="sendButton"
                                                text="Envoyer"
                                                onAction="#sendResponse"
                                                style="-fx-background-color: #A18E78;
                                                       -fx-text-fill: white;
                                                       -fx-border-radius: 8;
                                                       -fx-font-weight: bold;
                                                       -fx-padding: 8 16;
                                                       -fx-cursor: hand;"/>
                                    </children>
                                </HBox>

                                <Label fx:id="labelResponseError"
                                       textFill="red"
                                       visible="false"
                                       style="-fx-font-size: 12px;"/>
                            </children>
                        </VBox>

                    </children>
                </VBox>

            </children>
        </AnchorPane>
    </center>
</BorderPane>