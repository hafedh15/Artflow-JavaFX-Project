<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="900.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.AfficherReclamation"
            style="-fx-background-color: #F9F5F1;">

    <!-- Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #8D7D6D; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 3);">



            <!-- Original profile image container -->
            <StackPane fx:id="profileImageContainer" alignment="CENTER" style="-fx-padding: 20 0 5 0; -fx-cursor: hand;">
                <VBox alignment="CENTER" spacing="10">
                    <StackPane>
                        <Circle radius="40" fill="white" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 0);"/>
                        <ImageView fx:id="userProfileImage" fitWidth="80" fitHeight="80" preserveRatio="false">
                            <Image url="@/images/user.jpg" />
                            <clip>
                                <Circle radius="40" centerX="40" centerY="40" />
                            </clip>
                        </ImageView>

                        <!-- Camera overlay (appears on hover) -->
                        <StackPane fx:id="imageOverlay" opacity="0.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 40;">
                            <Circle radius="40" fill="transparent" />
                            <Label text="📷" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                        </StackPane>
                    </StackPane>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #E8DECD; -fx-font-weight: bold;" text="Artisan Admin" />
                </VBox>
            </StackPane>

            <!-- Add the Generate Avatar button below the profile image -->
            <Button fx:id="generateAvatarButton" text="Generate Avatar"
                    style="-fx-background-color: #7D6E58; -fx-text-fill: #E8DECD; -fx-font-size: 12px; -fx-padding: 5 10; -fx-background-radius: 20; -fx-cursor: hand;">
                <graphic>
                    <Label text="✨" style="-fx-font-size: 12px; -fx-text-fill: #E8DECD;" />
                </graphic>
                <VBox.margin>
                    <Insets bottom="15" />
                </VBox.margin>
            </Button>
            <Separator style="-fx-background-color: #6B5D4A; -fx-padding: 0 15 0 15;" />

            <!-- Navigation Menu -->
            <VBox spacing="5" style="-fx-padding: 10 5;">
                <Button fx:id="GoToUser" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: #6B5D4A; -fx-text-fill: #E8DECD; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Utilisateurs" onAction="#goToUser">
                    <graphic>
                        <Label text="👥" style="-fx-font-size: 16px; -fx-text-fill: #E8DECD;" />
                    </graphic>
                </Button>

                <Button fx:id="orderButton" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Commandes" onAction="#handleOrderButtonAction">
                    <graphic>
                        <Label text="🛒" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToProduit" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Produits" onAction="#goToProduit">
                    <graphic>
                        <Label text="📦" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToAtelier" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Ateliers" onAction="#goToAtelier">
                    <graphic>
                        <Label text="🔨" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReservation" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réservations" onAction="#goToReservation">
                    <graphic>
                        <Label text="📅" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToArticle" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Articles" onAction="#goToArticle">
                    <graphic>
                        <Label text="📝" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToComment" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Commentaires" onAction="#goToComment">
                    <graphic>
                        <Label text="💬" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReclamation" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réclamations" onAction="#goToReclamation">
                    <graphic>
                        <Label text="⚠️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReponse" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réponses" onAction="#goToReponse">
                    <graphic>
                        <Label text="↩️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom Menu -->
            <VBox spacing="5" style="-fx-padding: 10 5 20 5;">
                <Button maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Rapports">
                    <graphic>
                        <Label text="📊" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Déconnexion">
                    <graphic>
                        <Label text="🚪" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="20" style="-fx-padding: 30;">
                    <!-- Header -->
                    <HBox spacing="15" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);">
                        <Label text="Gestion des Réclamations" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                    </HBox>

                    <!-- Tableau Réclamations -->
                    <VBox spacing="15">
                        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 20; -fx-border-color: #E8DECD; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">

                            <TableView fx:id="tableView" prefHeight="450" prefWidth="850"
                                       style="-fx-background-color: white;
                                              -fx-border-color: #E8DECD;
                                              -fx-border-radius: 10;
                                              -fx-background-radius: 10;
                                              -fx-padding: 10;
                                              -fx-focus-color: transparent;
                                              -fx-faint-focus-color: transparent;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="idColumn" text="ID" prefWidth="70" style="-fx-alignment: CENTER;" />
                                    <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="80" style="-fx-alignment: CENTER;" />
                                    <TableColumn fx:id="messageColumn" text="Message" prefWidth="220" />
                                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="120" />
                                    <TableColumn fx:id="dateColumn" text="Date de création" prefWidth="160" />
                                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150" style="-fx-alignment: CENTER;" />
                                </columns>
                            </TableView>

                        </VBox>
                    </VBox>

                    <!-- Statistics Section -->
                    <VBox spacing="15">
                        <Label text="Statistiques des Réclamations" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />

                        <HBox spacing="20" alignment="CENTER">
                            <!-- Summary Cards -->
                            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 15; -fx-border-color: #E8DECD; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                <HBox spacing="15">
                                    <!-- Total Reclamations Card -->
                                    <VBox spacing="5" style="-fx-background-color: #F0E6D9; -fx-background-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                        <Label text="Total" style="-fx-font-size: 14px; -fx-text-fill: #7D6E5B;" />
                                        <Label fx:id="totalReclamationsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                                    </VBox>

                                    <!-- Open Reclamations Card -->
                                    <VBox spacing="5" style="-fx-background-color: #E8F4F9; -fx-background-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                        <Label text="Ouvertes" style="-fx-font-size: 14px; -fx-text-fill: #5B7D8D;" />
                                        <Label fx:id="openReclamationsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3A5C6D;" />
                                    </VBox>

                                    <!-- In Progress Reclamations Card -->
                                    <VBox spacing="5" style="-fx-background-color: #F9F0D9; -fx-background-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                        <Label text="En cours" style="-fx-font-size: 14px; -fx-text-fill: #8D7B5B;" />
                                        <Label fx:id="inProgressReclamationsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6D5C3A;" />
                                    </VBox>

                                    <!-- Closed Reclamations Card -->
                                    <VBox spacing="5" style="-fx-background-color: #E9F4E9; -fx-background-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                        <Label text="Fermées" style="-fx-font-size: 14px; -fx-text-fill: #5B8D5B;" />
                                        <Label fx:id="closedReclamationsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3A6D3A;" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox spacing="20">
                            <!-- Pie Chart for Status Distribution -->
                            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 15; -fx-border-color: #E8DECD; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                <Label text="Distribution par statut" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                                <PieChart fx:id="statusPieChart" prefHeight="300" prefWidth="400" legendVisible="true" />
                            </VBox>

                            <!-- Bar Chart for Reclamations over Time -->
                            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 15; -fx-border-color: #E8DECD; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                <Label text="Réclamations par période" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                                <BarChart fx:id="timeBarChart" prefHeight="300" prefWidth="400" legendVisible="true">
                                    <xAxis>
                                        <CategoryAxis side="BOTTOM" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis side="LEFT" label="Nombre" />
                                    </yAxis>
                                </BarChart>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>