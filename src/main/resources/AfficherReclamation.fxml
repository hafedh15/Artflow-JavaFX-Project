<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.controllers.AfficherReclamation">
    <children>
        <VBox spacing="10" alignment="CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <TableView fx:id="tableView" prefHeight="400" prefWidth="800">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="75" />
                    <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="75" />
                    <TableColumn fx:id="messageColumn" text="Message" prefWidth="200" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
                    <TableColumn fx:id="dateColumn" text="Date de création" prefWidth="150" />
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
