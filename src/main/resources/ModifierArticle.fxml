<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.artflow.controllers.ModifierArticle"
            prefWidth="900.0" prefHeight="600.0"
            style="-fx-background-color: #f9f5f1;">

    <VBox alignment="TOP_CENTER" spacing="25" layoutX="50" layoutY="20"
          style="-fx-padding: 30;">

        <Label text="✏️ Modifier un article"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />

        <VBox spacing="18" maxWidth="700">

            <!-- Titre -->
            <VBox spacing="5">
                <Label text="Titre" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <TextField fx:id="titreTF" promptText="Entrez le titre"
                           style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                  -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                <Label fx:id="titreStatus" style="-fx-font-size: 11px;" textFill="red" />
            </VBox>

            <!-- Contenu WebView + Toolbar -->
            <VBox spacing="5">
                <Label text="Contenu" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <ToolBar fx:id="toolbar" style="-fx-background-color: #fef7ea; -fx-border-color: #E8DECD; -fx-background-radius: 5;">
                    <Button fx:id="boldButton" text="B" style="-fx-font-weight: bold;" />
                    <Button fx:id="italicButton" text="/" style="-fx-font-style: italic;" />
                    <Button fx:id="underlineButton" text="U" style="-fx-underline: true;" />
                    <ColorPicker fx:id="colorPicker" />
                    <ComboBox fx:id="fontComboBox" prefWidth="150" promptText="Police" />
                </ToolBar>
                <WebView fx:id="contenuWebView" prefHeight="50"
                         style="-fx-border-color: #E8DECD; -fx-background-radius: 8; -fx-border-radius: 8;" />
                <Label fx:id="contenuStatus" style="-fx-font-size: 11px;" textFill="red" />
            </VBox>

            <!-- Date -->
            <VBox spacing="5">
                <Label text="Date de publication" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <DatePicker fx:id="dateTF"
                            style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                   -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                <Label fx:id="dateStatus" style="-fx-font-size: 11px;" textFill="red" />
            </VBox>

            <!-- Catégorie -->
            <VBox spacing="5">
                <Label text="Catégorie" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <TextField fx:id="categorieTF" promptText="Entrez la catégorie"
                           style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                  -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                <Label fx:id="categorieStatus" style="-fx-font-size: 11px;" textFill="red" />
            </VBox>

            <!-- Nom Auteur -->
            <VBox spacing="5">
                <Label text="Nom de l'auteur" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <TextField fx:id="nomauteurTF" promptText="Entrez le nom de l'auteur"
                           style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                  -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                <Label fx:id="nomauteurStatus" style="-fx-font-size: 11px;" textFill="red" />
            </VBox>

            <!-- Image -->
            <VBox spacing="5">
                <Label text="Image" style="-fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <HBox spacing="10">
                    <TextField fx:id="imageTF" promptText="Chemin de l'image" prefWidth="400"
                               style="-fx-background-color: white; -fx-border-color: #E8DECD;
                                      -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" />
                    <Button text="Parcourir" onAction="#image"
                            style="-fx-background-color: #A18E78; -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-font-weight: bold;" />
                </HBox>
            </VBox>
        </VBox>

        <!-- Boutons -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="Modifier" onAction="#modifier"
                    style="-fx-background-color: #5C4F3D; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;" />
            <Button text="Annuler" onAction="#annuler"
                    style="-fx-background-color: #E8DECD; -fx-text-fill: #5C4F3D;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;" />
        </HBox>

    </VBox>
</AnchorPane>
