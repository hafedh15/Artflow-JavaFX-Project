<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.AfficheArticleFront"
            prefWidth="1200" prefHeight="800"
            stylesheets="@/styles.css"
            style="-fx-background-color: #F9F5F1;">

    <!-- HEADER + CATÉGORIES + BARRE DE RECHERCHE -->
    <top>
        <VBox spacing="10">
            <!-- Header -->


            <!-- Catégories -->
            <HBox fx:id="categoryBar" alignment="CENTER" spacing="20" styleClass="category-bar">
                <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            </HBox>

            <!-- Barre de recherche -->
            <HBox alignment="CENTER" spacing="10">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
                <TextField fx:id="searchField" promptText="Rechercher un article..." prefWidth="500" styleClass="search-field"/>
                <Button text="Rechercher" styleClass="search-button" onAction="#rechercherArticles"/>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENU DÉFILANT -->
    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="30" style="-fx-padding: 20;">

                    <!-- CARROUSEL CENTRÉ POUR LES ARTICLES LES PLUS VUS -->
                    <!-- CARROUSEL CENTRÉ POUR LES ARTICLES LES PLUS VUS -->
                    <!-- ARTICLES LES PLUS POPULAIRES AVEC IMAGE À GAUCHE -->
                    <HBox spacing="40" alignment="CENTER">

                        <!-- Image musée à gauche, grande -->
                        <!-- Image musée à gauche, largeur = cartes affichées -->
                        <VBox alignment="CENTER" prefHeight="280" prefWidth="750"
                              style="-fx-background-radius: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);">
                            <ImageView fitWidth="800" fitHeight="280" preserveRatio="false">
                                <Image url="@/images/musee.png"/>
                            </ImageView>
                        </VBox>


                        <!-- Carrousel des articles à droite -->
                        <StackPane fx:id="carouselContainer" alignment="CENTER" prefHeight="280" prefWidth="360">
                            <padding><Insets top="0" bottom="0" left="0" right="0"/></padding>
                        </StackPane>

                    </HBox>



                    <!-- ARTICLES + RÉCENTS -->
                    <HBox spacing="20" alignment="TOP_CENTER">
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <FlowPane fx:id="flowPane" hgap="20" vgap="20" prefWrapLength="800"/>
                            <HBox fx:id="paginationContainer" alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                                <Button fx:id="prevButton" text="⟨ Précédent" onAction="#pagePrecedente"/>
                                <Label fx:id="pageLabel" text="Page 1" style="-fx-font-weight: bold;"/>
                                <Button fx:id="nextButton" text="Suivant ⟩" onAction="#pageSuivante"/>
                            </HBox>
                        </VBox>

                        <!-- Articles récents -->
                        <VBox spacing="15" prefWidth="300">
                            <Label text="🆕 Derniers Articles" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <VBox fx:id="recentPostsBox" spacing="10"
                                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;"/>
                        </VBox>
                    </HBox>

                    <!-- FOOTER -->
                    <HBox alignment="CENTER" spacing="10" styleClass="footer">
                        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
                        <Label text="© 2025 - Artisanat fait main avec passion"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
