<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.AfficheArticleFront"
            prefWidth="1200" prefHeight="800"
            stylesheets="@/styles.css"
            style="-fx-background-color: #F9F5F1;">

    <!-- HEADER -->
    <top>
        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

                <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
                    <Image url="@/images/logo.jpg"/>
                </ImageView>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Accueil" styleClass="nav-button"/>
                <Button text="Articles" styleClass="nav-button-active"/>
                <Button text="Ateliers" styleClass="nav-button"/>
                <Button text="Réclamations" styleClass="nav-button"/>
                <Button text="À propos" styleClass="nav-button"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button styleClass="cart-button">
                    <graphic>
                        <ImageView fitHeight="25" fitWidth="25">
                            <Image url="@/images/panier.jpg"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Button styleClass="user-icon">
                    <graphic>
                        <ImageView fitHeight="30" fitWidth="30">
                            <Image url="@/images/user.jpg"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <HBox fx:id="categoryBar" alignment="CENTER" spacing="20" styleClass="category-bar">
                <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            </HBox>

            <HBox alignment="CENTER" spacing="10">
                <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>
                <TextField fx:id="searchField" promptText="Rechercher un article..." prefWidth="500" styleClass="search-field"/>
                <Button text="Rechercher" styleClass="search-button" onAction="#rechercherArticles"/>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <StackPane>

            <VBox spacing="10">
                <HBox fx:id="robotBox" spacing="10" alignment="TOP_LEFT"
                      visible="true"
                      style="-fx-background-color: #FFF4D6; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <ImageView fx:id="robotImage" fitHeight="60" fitWidth="60"/>
                    <VBox fx:id="robotMessages" spacing="5"/>
                </HBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <content>
                        <HBox spacing="20" style="-fx-padding: 20;" alignment="CENTER">

                            <!-- ✔️ Zone principale des cartes d'articles -->
                            <FlowPane fx:id="flowPane" hgap="20" vgap="20" prefWrapLength="800"
                                      style="-fx-background-color: white; -fx-background-radius: 10;
                                             -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);"/>

                            <!-- ✔️ Articles récents -->
                            <VBox spacing="15" prefWidth="300">
                                <Label text="🆕 Derniers Articles" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <VBox fx:id="recentPostsBox" spacing="10"
                                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;"/>
                            </VBox>
                        </HBox>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- OVERLAY POPULAIRE -->
            <StackPane fx:id="robotOverlay" visible="true" style="-fx-background-color: rgba(0, 0, 0, 0.6);">
                <HBox spacing="20" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-max-width: 900;">

                    <!-- Robot + message -->
                    <VBox spacing="10" alignment="CENTER">
                        <ImageView fx:id="robotOverlayImage" fitHeight="80" fitWidth="80"/>
                        <Label text="🤖 Salut ! Voici les articles populaires à découvrir."
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;" />
                    </VBox>

                    <!-- Carrousel horizontal -->
                    <VBox alignment="CENTER">
                        <ScrollPane fx:id="carouselScrollPane"
                                    hbarPolicy="NEVER" vbarPolicy="NEVER"
                                    fitToHeight="true" fitToWidth="false"
                                    prefHeight="180" maxWidth="600"
                                    style="-fx-background-color: transparent;">
                            <HBox fx:id="carouselContent" spacing="15" style="-fx-padding: 10;" />
                        </ScrollPane>
                    </VBox>

                    <!-- Fermer -->
                    <Button text="❌" onAction="#fermerOverlay"
                            style="-fx-background-color: transparent; -fx-font-size: 18px;"/>
                </HBox>
            </StackPane>

        </StackPane>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="footer">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label text="© 2025 - Artisanat fait main avec passion"/>
        </HBox>
    </bottom>
</BorderPane>
