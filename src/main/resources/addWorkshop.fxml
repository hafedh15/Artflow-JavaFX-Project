<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.artflow.controllors.AddWorkshop"
            style="-fx-background-color: #FFEBCD;">

   <top>
      <HBox prefHeight="50.0" style="-fx-background-color: #FFB347; -fx-padding: 10;">
         <Label text="ARTFLOW" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
         <Region HBox.hgrow="ALWAYS"/>
         <Button text="+" style="-fx-background-color: transparent; -fx-text-fill: white;" />
      </HBox>
   </top>

   <center>
      <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">
         <TextField text="add.workshop" editable="false"
                    style="-fx-background-color: #FFF5E1; -fx-border-color: #FFD580; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 5; -fx-font-family: 'Courier New';"
                   />

         <GridPane hgap="10" vgap="15" style="-fx-background-color: white; -fx-border-color: #FFB347; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 30;">
            <columnConstraints>
               <ColumnConstraints halignment="RIGHT" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Title -->
            <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <VBox GridPane.rowIndex="0" GridPane.columnIndex="1">
               <TextField fx:id="txttitle" style="-fx-background-radius: 10;" />
               <Label fx:id="titleErrorLabel" textFill="red"/>
            </VBox>

            <!-- Description -->
            <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtdescription" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-background-radius: 10;" />

            <!-- Type -->
            <Label text="Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboType" GridPane.rowIndex="2" GridPane.columnIndex="1"
                      style="-fx-background-radius: 10;" />

            <!-- Image -->
            <Label text="Image:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1">
               <TextField fx:id="txtimage" style="-fx-background-radius: 10;" />
               <Button text="Choose File" onAction="#choosefile"
                       style="-fx-background-color: #FFA07A; -fx-text-fill: white; -fx-background-radius: 10;" />
            </HBox>
            <Label fx:id="imageErrorLabel" textFill="red" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <!-- Location -->
            <Label text="Location:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <VBox GridPane.rowIndex="5" GridPane.columnIndex="1">
               <TextField fx:id="txtlocation" style="-fx-background-radius: 10;" />
               <Label fx:id="locationErrorLabel" textFill="red"/>
            </VBox>

            <!-- Date -->
            <Label text="Date:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <VBox GridPane.rowIndex="6" GridPane.columnIndex="1">
               <DatePicker fx:id="date" style="-fx-background-radius: 10;" />
               <Label fx:id="dateErrorLabel" textFill="red"/>
            </VBox>

            <!-- Button -->


            <!-- Buttons -->
            <HBox spacing="20" GridPane.rowIndex="7" GridPane.columnIndex="1" alignment="CENTER_RIGHT">
               <Button text="Cancel" onAction="#cancelUpdate"
                       style="-fx-background-color: #FFA07A; -fx-text-fill: white; -fx-background-radius: 20;" />
               <Button text="Add Workshop" onAction="#addWorkshop"
                       style="-fx-background-color: #FF8C00; -fx-text-fill: white; -fx-background-radius: 20;" />
            </HBox>

         </GridPane>
      </VBox>
   </center>
</BorderPane>
