<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.AfficherArticle"
            style="-fx-background-color: #F9F5F1;">

    <!-- Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #E5DDD1; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 3);">

            <HBox alignment="CENTER" style="-fx-padding: 0 0 30 0;">
                <ImageView fitHeight="60" fitWidth="120" preserveRatio="true">
                    <Image url="@/images/logo.jpg" />
                </ImageView>
            </HBox>

            <HBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
                <VBox alignment="CENTER">
                    <ImageView fitHeight="50" fitWidth="50" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <Image url="@/images/user.jpg" />
                    </ImageView>
                    <Label text="Artisan Admin" style="-fx-font-size: 14px; -fx-text-fill: #7D6E5B; -fx-font-weight: bold; -fx-padding: 5 0 0 0;" />
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #D4C8B9;" />

            <Button text="Dashboard" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #8D7B6A; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />
            <Button text="Articles" maxWidth="Infinity" style="-fx-background-color: #C8B6A6; -fx-text-fill: #5C4F3D; -fx-font-size: 14px; -fx-background-radius: 5; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />
            <Button text="Commentaires" maxWidth="Infinity" style="-fx-background-color: #C8B6A6; -fx-text-fill: #5C4F3D; -fx-font-size: 14px; -fx-background-radius: 5; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Paramètres" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #8D7B6A; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <!-- Header -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);">
                <Label text="Gestion des Articles" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ Ajouter un article" onAction="#afficherFormulaireAjout"
                        style="-fx-background-color: #A18E78; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 20;" />
            </HBox>

            <!-- Tableau Articles -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 20; -fx-border-color: #E8DECD; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <GridPane fx:id="articleGrid" hgap="10" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="50"/>
                                    <ColumnConstraints prefWidth="150"/>
                                    <ColumnConstraints prefWidth="150"/>
                                    <ColumnConstraints prefWidth="150"/>
                                    <ColumnConstraints prefWidth="120"/>
                                    <ColumnConstraints prefWidth="170"/>
                                </columnConstraints>
                            </GridPane>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
