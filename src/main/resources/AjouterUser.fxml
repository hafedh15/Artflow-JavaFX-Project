<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Hyperlink?>
<StackPane style="-fx-background-color: linear-gradient(to bottom, #1e1e2f, #2c3e50);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.artflow.controllers.AjouterUser">

   <VBox alignment="CENTER" maxHeight="695.0" maxWidth="579.0" prefHeight="695.0" prefWidth="522.0" spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);">

      <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Create Your Account" />

      <TextField fx:id="txtName" promptText="First Name" style="-fx-background-radius: 8; -fx-padding: 10;" />
      <Label fx:id="nameError" style="-fx-font-size: 11px;" textFill="red" />

      <TextField fx:id="txtLastname" promptText="Last Name" style="-fx-background-radius: 8; -fx-padding: 10;" />
      <Label fx:id="lastnameError" style="-fx-font-size: 11px;" textFill="red" />

      <TextField fx:id="txtemail" promptText="Email" style="-fx-background-radius: 8; -fx-padding: 10;" />
      <Label fx:id="emailError" style="-fx-font-size: 11px;" textFill="red" />

      <PasswordField fx:id="txtpassword" promptText="Password" style="-fx-background-radius: 8; -fx-padding: 10;" />
      <Label fx:id="passwordError" style="-fx-font-size: 11px;" textFill="red" />

      <PasswordField fx:id="txtConfirmPassword" promptText="Confirm Password" style="-fx-background-radius: 8; -fx-padding: 10;" />
      <Label fx:id="confirmPasswordError" style="-fx-font-size: 11px;" textFill="red" />

      <!-- Sign Up Button -->
      <Button fx:id="btnSignUp" maxWidth="Infinity" onAction="#AjouterUser" onMouseEntered="#hoverSignUp" onMouseExited="#unhoverSignUp"
                       style="-fx-background-color: #4CAF50;
                      -fx-text-fill: white;
                      -fx-font-weight: bold;
                      -fx-background-radius: 8;
                      -fx-padding: 12 0;
                      -fx-cursor: hand;" text="Sign Up" />

      <Hyperlink text="Continue With Google?"
                 style="-fx-text-fill: #2196F3; -fx-font-size: 12px;" />

      <!-- Google Sign Up Button -->
      <Button fx:id="btnGoogleSignUp" maxWidth="Infinity" onAction="#signUpWithGoogle" onMouseEntered="#hoverGoogle" onMouseExited="#unhoverGoogle" style="-fx-background-color: #ccc2c0;                -fx-text-fill: white;                -fx-font-weight: bold;                -fx-background-radius: 8;                -fx-padding: 12 0;                -fx-graphic-text-gap: 10;                -fx-cursor: hand;">
         <graphic>
            <ImageView fx:id="googleIcon" fitHeight="18" fitWidth="18" pickOnBounds="true" preserveRatio="true" />
         </graphic>
         <text>Sign Up with Google</text>
      </Button>


      <!-- Login Button -->
      <Button fx:id="btnGoLogin" onAction="#goToLogin" style="-fx-background-color: transparent;
                       -fx-text-fill: #007BFF;
                       -fx-font-size: 14px;
                       -fx-padding: 10;
                       -fx-cursor: hand;" text="Already have an account? Login here" />

   </VBox>

</StackPane>
