<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.AjouterProduct"
            prefHeight="700.0" prefWidth="800.0"
            stylesheets="@/styles.css">


   <!-- Contenu principal - formulaire d'ajout de produit -->
   <center>
      <VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f8f4ea;">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="page-title" text="Ajouter un nouveau produit">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>

            <!-- Nom du produit -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Nom du produit">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtname" promptText="Entrez le nom du produit" styleClass="input-field" />
                  <Label fx:id="errorName" text="Le nom est obligatoire" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Description -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Description">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtdescription" promptText="Entrez la description" styleClass="input-field" />
                  <Label fx:id="errorDescription" text="La description est obligatoire" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Prix -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Prix">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtprice" promptText="Entrez le prix" styleClass="input-field" />
                  <Label fx:id="errorPrice" text="Prix invalide" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Catégorie -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Catégorie">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtcategory" promptText="Entrez la catégorie" styleClass="input-field" />
                  <Label fx:id="errorCategory" text="La catégorie est obligatoire" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Image -->
            <VBox maxWidth="600.0" spacing="5.0">
               <children>
                  <Label styleClass="field-label" text="Image">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="txtimage" editable="false" promptText="Chemin de l'image" HBox.hgrow="ALWAYS" styleClass="input-field" />
                        <Button mnemonicParsing="false" onAction="#choosefile" styleClass="browse-button" text="Parcourir">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
                  <Label fx:id="errorImage" text="Veuillez sélectionner une image" textFill="RED" visible="false" />
               </children>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addProduct" styleClass="action-button" text="Ajouter le produit">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#goToProductList" styleClass="cancel-button" text="Annuler">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </center>

   <!-- Pied de page -->
   <bottom>
      <HBox alignment="CENTER" spacing="10" styleClass="footer">
         <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
         <Label text="© 2025 - Artisanat fait main avec passion" />
      </HBox>
   </bottom>
</BorderPane>