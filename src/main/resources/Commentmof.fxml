<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.Commentmof"
            prefHeight="100.0" prefWidth="600.0"
            style="-fx-background-color: #f8f8f8; -fx-padding: 10; -fx-border-color: #dddddd; -fx-border-radius: 8; -fx-background-radius: 8;">

    <VBox spacing="8">
        <!-- Affichage du commentaire -->
        <Label fx:id="contenuLabel" wrapText="true" onMouseClicked="#activerModification"
               style="-fx-font-size: 14px; -fx-text-fill: #333333;" />

        <!-- Zone d'édition -->
        <TextArea fx:id="editTextArea" visible="false" managed="false"
                  style="-fx-border-radius: 6; -fx-background-radius: 6;" />

        <!-- Boutons d'action (modifier / annuler / supprimer) -->
        <HBox fx:id="buttonsBox" spacing="10" alignment="CENTER_LEFT"
              visible="false" managed="false">
            <Button text="✅" onAction="#confirmerModification"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            <Button text="❌" onAction="#annulerModification"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white;"/>
            <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>
            <Button text="🗑 Supprimer" onAction="#supprimerCommentaire"
                    style="-fx-background-color: #ff6b4a; -fx-text-fill: white;"/>
        </HBox>
    </VBox>

</AnchorPane>
