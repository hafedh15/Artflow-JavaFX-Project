<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.artflow.controllers.TokenValidationController"
      style="-fx-background-color: linear-gradient(to bottom right, #e0eafc, #cfdef3);
             -fx-padding: 30;
             -fx-background-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);"
      prefWidth="400" prefHeight="300">

    <Label text="Enter the token you received by email:"
           style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #333;
                  -fx-font-family: 'Segoe UI';" />

    <TextField fx:id="tokenField"
               promptText="Enter token here"
               maxWidth="280"
               style="-fx-background-radius: 8;
                      -fx-border-color: #ccc;
                      -fx-border-radius: 8;
                      -fx-padding: 10;
                      -fx-font-size: 14px;" />

    <Button fx:id="validateTokenButton"
            text="Validate Token"
            onAction="#handleValidateToken"
            style="-fx-background-color: #2196F3;
                   -fx-text-fill: white;
                   -fx-background-radius: 8;
                   -fx-font-size: 14px;
                   -fx-padding: 10 20;
                   -fx-cursor: hand;
                   -fx-font-weight: bold;"
            onMouseEntered="#hoverValidateButton"
            onMouseExited="#unhoverValidateButton" />

    <Label fx:id="errorLabel"
           textFill="red"
           style="-fx-font-size: 12px;
                  -fx-text-fill: #f44336;" />

</VBox>
