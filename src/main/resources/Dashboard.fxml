<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<?import javafx.geometry.Insets?>
<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F9F5F1;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.artflow.controllers.AdminDashboardController">

    <!-- Panneau de navigation latéral - style artisanal avec tons marron doux -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #8D7D6D;
                               -fx-padding: 20;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0.5, 4, 0);">   <!-- Logo -->


            <!-- Original profile image container -->
            <StackPane fx:id="profileImageContainer" alignment="CENTER" style="-fx-padding: 20 0 5 0; -fx-cursor: hand;">
                <VBox alignment="CENTER" spacing="10">
                    <StackPane>
                        <Circle radius="40" fill="white" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 0);"/>
                        <ImageView fx:id="userProfileImage" fitWidth="80" fitHeight="80" preserveRatio="false">
                            <Image url="@/images/user.jpg" />
                            <clip>
                                <Circle radius="40" centerX="40" centerY="40" />
                            </clip>
                        </ImageView>

                        <!-- Camera overlay (appears on hover) -->
                        <StackPane fx:id="imageOverlay" opacity="0.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 40;">
                            <Circle radius="40" fill="transparent" />
                            <Label text="📷" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                        </StackPane>
                    </StackPane>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #E8DECD; -fx-font-weight: bold;" text="Artisan Admin" />
                </VBox>
            </StackPane>

            <!-- Add the Generate Avatar button below the profile image -->
            <Button fx:id="generateAvatarButton" text="Generate Avatar"
                    style="-fx-background-color: #7D6E58; -fx-text-fill: #E8DECD; -fx-font-size: 12px; -fx-padding: 5 10; -fx-background-radius: 20; -fx-cursor: hand;">
                <graphic>
                    <Label text="✨" style="-fx-font-size: 12px; -fx-text-fill: #E8DECD;" />
                </graphic>
                <VBox.margin>
                    <Insets bottom="15" />
                </VBox.margin>
            </Button>
            <Separator style="-fx-background-color: #6B5D4A; -fx-padding: 0 15 0 15;" />

            <!-- Navigation Menu -->
            <VBox spacing="5" style="-fx-padding: 10 5;">
                <Button fx:id="GoToUser" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #E8DECD; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Utilisateurs" onAction="#goToUser">
                    <graphic>
                        <Label text="👥" style="-fx-font-size: 16px; -fx-text-fill: #E8DECD;" />
                    </graphic>
                </Button>

                <Button fx:id="orderButton" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Commandes" onAction="#handleOrderButtonAction">
                    <graphic>
                        <Label text="🛒" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToProduit" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Produits" onAction="#goToProduit">
                    <graphic>
                        <Label text="📦" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToAtelier" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Ateliers" onAction="#goToAtelier">
                    <graphic>
                        <Label text="🔨" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReservation" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réservations" onAction="#goToReservation">
                    <graphic>
                        <Label text="📅" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToArticle" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Articles" onAction="#goToArticle">
                    <graphic>
                        <Label text="📝" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToComment" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Commentaires" onAction="#goToComment">
                    <graphic>
                        <Label text="💬" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReclamation" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réclamations" onAction="#goToReclamation">
                    <graphic>
                        <Label text="⚠️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button fx:id="GoToReponse" maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Réponses" onAction="#goToReponse">
                    <graphic>
                        <Label text="↩️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom Menu -->
            <VBox spacing="5" style="-fx-padding: 10 5 20 5;">
                <Button maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Rapports">
                    <graphic>
                        <Label text="📊" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>

                <Button maxWidth="Infinity" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                        text="Déconnexion">
                    <graphic>
                        <Label text="🚪" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- Zone principale -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <!-- En-tête avec titre de page et recherche -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox>
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" text="Gestion des Produits" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #8D7B6A;" text="Gérez votre catalogue d'artisanat" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button maxWidth="Infinity" style="-fx-background-color: #C8B6A6; -fx-text-fill: #5C4F3D; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-background-radius: 5;" text="Produits" fx:id="productsButton" onAction="#handleProductsButtonClick">
                    <graphic>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitHeight="16" fitWidth="16">
                                <Image url="@/images/belll.jpeg" />
                            </ImageView>
                            <!-- Indicateur de notification -->
                            <StackPane fx:id="productNotificationBadge" visible="true" managed="true">
                                <Circle radius="8" fill="#FF5252" />
                                <Label fx:id="productNotificationCount" style="-fx-font-size: 10px; -fx-text-fill: white; -fx-font-weight: bold;" text="0" />
                            </StackPane>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

            <!-- Statistiques en cartes - Disposition modifiée -->
            <HBox spacing="20">
                <!-- Conteneur gauche avec les statistiques l'un sous l'autre -->
                <VBox spacing="15" prefWidth="250">
                    <!-- Carte Total Produits -->
                    <StackPane prefHeight="100" prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);">
                        <VBox alignment="CENTER_LEFT" style="-fx-padding: 15;">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane prefHeight="50" prefWidth="50" style="-fx-background-color: #F2EDE7; -fx-background-radius: 10;">
                                    <ImageView fitHeight="24" fitWidth="24">
                                        <Image url="@/images/product.jpg" />
                                    </ImageView>
                                </StackPane>
                                <VBox>
                                    <Label style="-fx-font-size: 14px; -fx-text-fill: #8D7B6A;" text="Total Produits" />
                                    <Label fx:id="totalProductsLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" text="45" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Carte Produits en Attente -->
                    <StackPane prefHeight="100" prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);">
                        <VBox alignment="CENTER_LEFT" style="-fx-padding: 15;">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane prefHeight="50" prefWidth="50" style="-fx-background-color: #F2EDE7; -fx-background-radius: 10;">
                                    <ImageView fitHeight="24" fitWidth="24">
                                        <Image url="@/images/attente.png" />
                                    </ImageView>
                                </StackPane>
                                <VBox>
                                    <Label style="-fx-font-size: 14px; -fx-text-fill: #8D7B6A;" text="Produits en Attente" />
                                    <Label fx:id="pendingProductsLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" text="45" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </StackPane>
                </VBox>

                <!-- Graphique des catégories (inchangé mais avec espace ajusté) -->
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #E8DECD; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1); -fx-padding: 15;">
                    <BarChart fx:id="categoryChart" title="Nombre de Produits par Catégorie">
                        <xAxis>
                            <CategoryAxis fx:id="xAxis" label="Catégorie"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" label="Nombre de Produits"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- Actions avec les boutons - REDESIGNED SECTION -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                <Button fx:id="addProductButton" onAction="#handleAddProduct"
                        style="-fx-background-color: #A18E78; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 15;"
                        text="Ajouter Produit">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="@/images/product.jpg" />
                        </ImageView>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Groupe export sur la droite -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <ComboBox fx:id="exportComboBox" prefWidth="200" promptText="Sélectionner une catégorie"
                              style="-fx-background-color: white; -fx-border-color: #C8B6A6; -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 13px;">
                        <!-- Les éléments seront ajoutés dynamiquement dans le contrôleur -->
                    </ComboBox>

                    <Button fx:id="exportButton" onAction="#handleExportButtonClick"
                            style="-fx-background-color: #A18E78; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;"
                            text="Exporter">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16">
                                <Image url="@/images/export.jpeg" />
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <!-- Zone de contenu scrollable -->
            <ScrollPane fitToWidth="true" prefHeight="368.0" prefWidth="866.0"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <content>
                    <FlowPane fx:id="productsContainer" hgap="20" vgap="20" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                        <!-- Les cartes produits seront ajoutées ici par le contrôleur -->
                    </FlowPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>