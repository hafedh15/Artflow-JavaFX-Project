<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>
<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.artflow.controllers.DashWorkshop"
            style="-fx-background-color: #F9F5F1;">

  <!-- Sidebar -->
  <left>
    <VBox spacing="10" style="-fx-background-color: #8D7D6D;
                               -fx-padding: 20;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0.5, 4, 0);">


      <!-- Original profile image container -->
      <StackPane fx:id="profileImageContainer" alignment="CENTER" style="-fx-padding: 20 0 5 0; -fx-cursor: hand;">
        <VBox alignment="CENTER" spacing="10">
          <StackPane>
            <Circle radius="40" fill="white" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 0);"/>
            <ImageView fx:id="userProfileImage" fitWidth="80" fitHeight="80" preserveRatio="false">
              <Image url="@/images/user.jpg" />
              <clip>
                <Circle radius="40" centerX="40" centerY="40" />
              </clip>
            </ImageView>

            <!-- Camera overlay (appears on hover) -->
            <StackPane fx:id="imageOverlay" opacity="0.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 40;">
              <Circle radius="40" fill="transparent" />
              <Label text="📷" style="-fx-font-size: 20px; -fx-text-fill: white;" />
            </StackPane>
          </StackPane>
          <Label style="-fx-font-size: 14px; -fx-text-fill: #E8DECD; -fx-font-weight: bold;" text="Artisan Admin" />
        </VBox>
      </StackPane>

      <!-- Add the Generate Avatar button below the profile image -->
      <Button fx:id="generateAvatarButton" text="Generate Avatar"
              style="-fx-background-color: #7D6E58; -fx-text-fill: #E8DECD; -fx-font-size: 12px; -fx-padding: 5 10; -fx-background-radius: 20; -fx-cursor: hand;">
        <graphic>
          <Label text="✨" style="-fx-font-size: 12px; -fx-text-fill: #E8DECD;" />
        </graphic>
        <VBox.margin>
          <Insets bottom="15" />
        </VBox.margin>
      </Button>
      <Separator style="-fx-background-color: #6B5D4A; -fx-padding: 0 15 0 15;" />

      <!-- Navigation Menu -->
      <VBox spacing="5" style="-fx-padding: 10 5;">
        <Button fx:id="GoToUser" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #E8DECD; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Utilisateurs" onAction="#goToUser">
          <graphic>
            <Label text="👥" style="-fx-font-size: 16px; -fx-text-fill: #E8DECD;" />
          </graphic>
        </Button>

        <Button fx:id="orderButton" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Commandes" onAction="#handleOrderButtonAction">
          <graphic>
            <Label text="🛒" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button fx:id="GoToProduit" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Produits" onAction="#goToProduit">
          <graphic>
            <Label text="📦" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button fx:id="GoToAtelier" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Ateliers" onAction="#goToAtelier">
          <graphic>
            <Label text="🔨" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button fx:id="GoToReservation" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Réservations" onAction="#goToReservation">
          <graphic>
            <Label text="📅" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button fx:id="GoToArticle" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Articles" onAction="#goToArticle">
          <graphic>
            <Label text="📝" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button fx:id="GoToComment" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Commentaires" onAction="#goToComment">
          <graphic>
            <Label text="💬" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button fx:id="GoToReclamation" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Réclamations" onAction="#goToReclamation">
          <graphic>
            <Label text="⚠️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button fx:id="GoToReponse" maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Réponses" onAction="#goToReponse">
          <graphic>
            <Label text="↩️" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>
      </VBox>

      <Region VBox.vgrow="ALWAYS" />

      <!-- Bottom Menu -->
      <VBox spacing="5" style="-fx-padding: 10 5 20 5;">
        <Button maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Rapports">
          <graphic>
            <Label text="📊" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>

        <Button maxWidth="Infinity" styleClass="sidebar-button"
                style="-fx-background-color: transparent; -fx-text-fill: #D1C4AF; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 12 15; -fx-background-radius: 0;"
                text="Déconnexion">
          <graphic>
            <Label text="🚪" style="-fx-font-size: 16px; -fx-text-fill: #D1C4AF;" />
          </graphic>
        </Button>
      </VBox></VBox>
  </left>

  <!-- Contenu principal -->
  <center>
    <AnchorPane style="-fx-background-color: #F9F5F1; -fx-padding: 20;">
      <VBox layoutX="20" layoutY="20" spacing="20" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"
            AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">

        <!-- Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);">
          <Label text="Workshop Dashboard"
                 style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C4F3D;" />
          <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>
          <Button text="➕ Add Workshop" onAction="#addworkshop"
                  style="-fx-background-color: #A18E78; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 20;"/>


          <TextField fx:id="searchField" onKeyReleased="#searchWorkshops" promptText="Search by title"
                     style="-fx-background-color: #F5F0EB;
                  -fx-border-color: #C8B6A6;
                  -fx-border-radius: 15;
                  -fx-background-radius: 15;
                  -fx-padding: 5 15;
                  -fx-font-size: 14px;
                  -fx-text-fill: #5C4F3D;" />

          <Button text="Sort by date" onAction="#sortByDate"
                  style="-fx-background-color: #D3C1B0;
               -fx-text-fill: #5C4F3D;
               -fx-font-weight: bold;
               -fx-background-radius: 20;
               -fx-padding: 8 16;
               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);" />

        </HBox>

        <!-- Scrollable Workshop Grid -->
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
          <content>
            <GridPane fx:id="gridWorkshop"
                      alignment="CENTER"
                      hgap="15" vgap="10"
                      style="-fx-padding: 20;
                                         -fx-background-color: white;
                                         -fx-background-radius: 10;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);
                                         -fx-border-color: #E8DECD;
                                         -fx-border-radius: 10;">
              <columnConstraints>
                <ColumnConstraints prefWidth="200"/>
                <ColumnConstraints prefWidth="200"/>
                <ColumnConstraints prefWidth="200"/>
                <ColumnConstraints prefWidth="200"/>
                <ColumnConstraints prefWidth="200"/>
                <ColumnConstraints prefWidth="200"/>
              </columnConstraints>
              <rowConstraints>
                <RowConstraints prefHeight="40"/>
                <RowConstraints prefHeight="40"/>
                <RowConstraints prefHeight="40"/>
                <RowConstraints prefHeight="40"/>
                <RowConstraints prefHeight="40"/>
                <RowConstraints prefHeight="40"/>
              </rowConstraints>
            </GridPane>
          </content>
        </ScrollPane>

      </VBox>
    </AnchorPane>
  </center>

</BorderPane>