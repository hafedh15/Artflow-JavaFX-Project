<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.artflow.controllers.ForgotPasswordController"
            prefWidth="400" prefHeight="250"
            style="-fx-background-color: linear-gradient(to bottom right, #e0eafc, #cfdef3);">

    <VBox spacing="15" alignment="CENTER"
          layoutX="30" layoutY="20"
          prefWidth="340"
          AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30"
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);">

        <Label text="Reset Your Password"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #333;
                      -fx-font-family: 'Segoe UI';" />

        <TextField fx:id="emailField"
                   promptText="Enter your email"
                   maxWidth="280"
                   style="-fx-background-radius: 8;
                          -fx-border-color: #ccc;
                          -fx-border-radius: 8;
                          -fx-padding: 10;
                          -fx-font-size: 14px;" />

        <Label fx:id="emailError"
               textFill="red"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #f44336;" />

        <Button fx:id="sendResetButton"
                text="Send Reset Link"
                onAction="#handleSendResetLink"
                style="-fx-background-color: #4CAF50;
                       -fx-text-fill: white;
                       -fx-background-radius: 8;
                       -fx-font-size: 14px;
                       -fx-padding: 10 20;
                       -fx-cursor: hand;
                       -fx-font-weight: bold;"
                onMouseEntered="#hoverSendButton"
                onMouseExited="#unhoverSendButton" />

        <Label fx:id="successLabel"
               textFill="green"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #4CAF50;" />
    </VBox>
</AnchorPane>
