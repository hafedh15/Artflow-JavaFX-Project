<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.artflow.controllers.Profilp">
    <!-- Barre de navigation supérieure -->

    <!-- Contenu principal - TabPane pour organiser les différentes sections -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Vos Produits">
                <VBox alignment="TOP_CENTER" spacing="15">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <!-- Titre de la page -->
                    <Label styleClass="page-title" text="Bienvenue sur votre profil" />

                    <!-- En-tête avec le sous-titre et le bouton d'ajout -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label styleClass="section-title" text="Vos produits :" />
                        <Region HBox.hgrow="ALWAYS" />

                    </HBox>

                    <!-- Liste des produits -->
                    <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <content>
                            <ListView fx:id="productListView" styleClass="product-list-view" />
                        </content>
                    </ScrollPane>
                </VBox>
            </Tab>

            <!-- Nouvel onglet pour les demandes de produits -->
            <Tab text="Vos demandes de postuler un produit">
                <VBox alignment="TOP_CENTER" spacing="15">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <!-- Titre de la section demandes -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label styleClass="section-title" text="Vos demandes de produits" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addProductRequestButton" onAction="#addNewProductRequest" styleClass="add-button" text="+ Nouvelle demande" />
                    </HBox>

                    <!-- Liste des demandes de produits -->
                    <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <content>
                            <ListView fx:id="productRequestListView" styleClass="product-request-list" />
                        </content>
                    </ScrollPane>

                    <!-- Message si aucune demande -->
                    <Label fx:id="noRequestsLabel" styleClass="info-text" text="Vous n'avez pas encore fait de demande de produit." visible="false" />
                </VBox>
            </Tab>

            <Tab text="Historique des Commandes">
                <VBox alignment="TOP_CENTER" spacing="15">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <!-- Titre de la section historique -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label styleClass="section-title" text="Votre Historique de Commandes" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="printOrderHistoryButton" onAction="#printOrderHistory" styleClass="secondary-button" text="Imprimer" />
                        <Button fx:id="editDeliveryButton" onAction="#editDeliveryInfo" styleClass="secondary-button" text="Modifier les données de livraison" />
                        <Button fx:id="PayerButton" onAction="#Payer" styleClass="secondary-button" text="Payer " />
                    </HBox>

                    <!-- Liste des commandes -->
                    <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <content>
                            <ListView fx:id="orderHistoryListView" styleClass="order-history-list" />
                        </content>
                    </ScrollPane>

                    <!-- Message si aucune commande -->
                    <Label fx:id="noOrdersLabel" styleClass="info-text" text="Vous n'avez pas encore passé de commande." visible="false" />
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox alignment="CENTER" styleClass="footer">
            <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>
            <Label text="© 2025 - Artisan" />
        </HBox>
    </bottom>
</BorderPane>