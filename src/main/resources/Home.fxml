<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>


<BorderPane xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.artflow.controllers.HomeController"
            prefHeight="700.0" prefWidth="1200.0"
            stylesheets="@/dashboardDesign.css">

    <!-- Top navigation bar inspirée de Freshy -->
    <top>
        <HBox alignment="CENTER" styleClass="top-bar-freshy">
            <!-- Logo à gauche -->
            <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="logo-area">
                <Label text="Artflow" styleClass="freshy-logo-text"/>
            </HBox>

            <!-- Menu principal au centre -->
            <HBox alignment="CENTER" spacing="35" styleClass="freshy-menu">

                        <Button text="Workshops" onAction="#handleAfficherEvent" styleClass="freshy-menu-item"/>


                        <Button text="Articles" onAction="#handleAfficherArticle" styleClass="freshy-menu-item"/>

                <MenuButton text="Reclamations" styleClass="freshy-menu-item">
                    <items>
                        <MenuItem text="Send Claim" onAction="#handleAjouterReclamation" />
                        <MenuItem text="My Conversation" onAction="#handleAjouterReponse"/>
                    </items>
                </MenuButton>

                        <Button text="Products" onAction="#handleAfficherProduct" styleClass="freshy-menu-item" />


            </HBox>

            <!-- Bouton d'action à droite -->
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                <Button fx:id="profileButton"
                        onAction="#goToProfil"
                        style="-fx-background-color: transparent;">
                    <graphic>
                        <StackPane>
                            <Circle radius="15" fill="TRANSPARENT" stroke="#603813" strokeWidth="1.5" />
                            <Text text="📅" style="-fx-font-size: 14px; -fx-fill: #603813;" />
                        </StackPane>
                    </graphic>
                    <padding>
                        <Insets top="5" right="5" bottom="5" left="5" />
                    </padding>
                </Button>


                <Button styleClass="icon-button" onAction="#handleAfficherCart">
              <!--  <Button text="Créer un événement" styleClass="freshy-action-button" /> -->

                    <graphic>
                        <StackPane>
                            <Circle radius="15" fill="TRANSPARENT" stroke="#603813" strokeWidth="1.5" />
                            <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                                     scaleX="0.7" scaleY="0.7" fill="#603813" />
                        </StackPane>
                    </graphic>
                    <padding>
                        <Insets top="5" right="5" bottom="5" left="5" />
                    </padding>
                </Button>
                <Button styleClass="icon-button" onAction="#handleProfil">
                    <graphic>
                        <StackPane>
                            <Circle radius="15" fill="TRANSPARENT" stroke="#603813" strokeWidth="1.5" />
                            <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                     scaleX="0.7" scaleY="0.7" fill="#603813" />
                        </StackPane>
                    </graphic>
                    <padding>
                        <Insets top="5" right="5" bottom="5" left="5" />
                    </padding>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- Contenu principal avec layout inspiré de Freshy -->
    <center>
        <StackPane styleClass="freshy-content-area">
            <HBox>
                <!-- Zone de contenu principale (à gauche) -->
                <VBox styleClass="freshy-main-content" HBox.hgrow="ALWAYS">

                    <!-- Zone de contenu dynamique -->
                    <AnchorPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="freshy-dynamic-content">
                        <!-- Contenu par défaut (image centrale comme dans Freshy) -->
                        <VBox fx:id="welcomeContent" alignment="CENTER" styleClass="freshy-default-content"
                              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                            <StackPane styleClass="freshy-featured-image-container">
                                <Circle radius="150" styleClass="freshy-plate-circle"/>
                                <!-- Ici, on remplacerait par une image d'événement -->
                                <Label text="📅" styleClass="freshy-featured-icon">
                                    <font>
                                        <Font size="80.0" />
                                    </font>
                                </Label>
                            </StackPane>
                        </VBox>
                    </AnchorPane>
                </VBox>

                <!-- Sidebar des éléments (à droite) comme les plats dans Freshy
                <VBox styleClass="freshy-sidebar">
                    <Label text="Événements à venir" styleClass="freshy-sidebar-title"/>

                    <HBox styleClass="freshy-sidebar-item, freshy-sidebar-item-active" onMouseClicked="#handleAfficherEvent">
                        <StackPane styleClass="freshy-item-image-container">
                            <Circle radius="25" styleClass="freshy-item-image-circle"/>
                            <Label text="🎭" styleClass="freshy-item-icon"/>
                        </StackPane>
                        <VBox styleClass="freshy-item-details">
                            <Label text="FESTIVAL DE THÉÂTRE" styleClass="freshy-item-title"/>
                            <Label text="20-25 Juin • Théâtre National" styleClass="freshy-item-subtitle"/>
                        </VBox>
                    </HBox>

                    <HBox styleClass="freshy-sidebar-item" onMouseClicked="#handleAfficherEvent">
                        <StackPane styleClass="freshy-item-image-container">
                            <Circle radius="25" styleClass="freshy-item-image-circle"/>
                            <Label text="🎨" styleClass="freshy-item-icon"/>
                        </StackPane>
                        <VBox styleClass="freshy-item-details">
                            <Label text="EXPOSITION D'ART" styleClass="freshy-item-title"/>
                            <Label text="15-30 Juillet • Galerie Moderne" styleClass="freshy-item-subtitle"/>
                        </VBox>
                    </HBox>

                    <HBox styleClass="freshy-sidebar-item" onMouseClicked="#handleAfficherEvent">
                        <StackPane styleClass="freshy-item-image-container">
                            <Circle radius="25" styleClass="freshy-item-image-circle"/>
                            <Label text="🎵" styleClass="freshy-item-icon"/>
                        </StackPane>
                        <VBox styleClass="freshy-item-details">
                            <Label text="CONCERT PHILHARMONIQUE" styleClass="freshy-item-title"/>
                            <Label text="5 Août • Salle de Concert" styleClass="freshy-item-subtitle"/>
                        </VBox>
                    </HBox>

                    <HBox styleClass="freshy-sidebar-item" onMouseClicked="#handleAfficherEvent">
