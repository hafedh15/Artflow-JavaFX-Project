<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.Contollers.OrderDetails"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@/styles.css">

    <!-- Barre de navigation supérieure -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

                <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
                    <Image url="@/images/logo.jpg"/>
                </ImageView>

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#goToHome" styleClass="nav-button" text="Accueil" />
                <Button onAction="#goToProductList" style="-fx-background-color: #e5e5e5;" styleClass="nav-button" text="Produits" />
                <Button styleClass="nav-button" text="Ateliers" />
                <Button  styleClass="nav-button" text="Reclamations" />
                <Button  styleClass="nav-button" text="À propos" />


                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="cartButton" styleClass="cart-button" onAction="#openCart">
                    <graphic>
                        <ImageView fitHeight="25" fitWidth="25">
                            <Image url="@/images/panier.jpg"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button styleClass="user-icon" onAction="#profil">
                    <graphic>
                        <ImageView fitHeight="30" fitWidth="30">
                            <Image url="@/images/user.jpg"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- Formulaire centré avec titre et citation -->
    <center>
        <VBox alignment="CENTER" spacing="15" maxWidth="400">
            <padding><Insets top="30" bottom="50"/></padding>

            <!-- Titre -->
            <Label text="🧾 Finalisez votre commande" styleClass="form-title" />

            <!-- Citation -->
            <Label text="« 🎨 L'artisanat est le cœur de la tradition et l'âme de la créativité. 💫 »"
                   wrapText="true"
                   textAlignment="CENTER"
                   style="-fx-font-style: italic; -fx-text-fill: #666666;" />

            <!-- Adresse -->
            <TextField fx:id="addressField" promptText="📍 Adresse de livraison" />
            <Label fx:id="addressErrorLabel" textFill="red" style="-fx-font-size: 12;" />

            <!-- Téléphone -->
            <TextField fx:id="phoneField" promptText="📞 Numéro de téléphone" />
            <Label fx:id="phoneErrorLabel" textFill="red" style="-fx-font-size: 12;" />

            <Button fx:id="confirmOrderButton" text="✅ Confirmer la commande" onAction="#confirmOrder"/>
            <ImageView fx:id="successGif"
                       fitHeight="150" fitWidth="150"
                       visible="false"
                       preserveRatio="true"
                       style="-fx-margin-top: 20;">
                <Image url="@/images/success.gif"/>
            </ImageView>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="footer">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label text="© 2025 -  Artisanat fait main avec passion ❤️" />
        </HBox>
    </bottom>


</BorderPane>
